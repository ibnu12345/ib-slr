# =====================================================================
# IB-SLR: Environment Variables Configuration (.env.example)
# IMPORTANT: Never commit actual secret keys or credentials to Git!
# =====================================================================

# ---------------------------------------------------------------------
# Application Core & Base URL
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="IB-SLR"
NEXT_PUBLIC_APP_TAGLINE="From Literature to Evidence."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------
# Supabase Database & Auth (or PostgreSQL Direct Connection)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Service role key is STRICTLY server-side only; never expose in NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Direct PostgreSQL database connection URL (for migrations and direct queries)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ib_slr"

# ---------------------------------------------------------------------
# Authentication & Session Security
# ---------------------------------------------------------------------
SESSION_SECRET="your-32-character-random-session-secret"
JWT_SECRET="your-jwt-signing-secret"
EMAIL_VERIFICATION_REQUIRED="true"

# ---------------------------------------------------------------------
# AI Provider Credentials (Server-side Only)
# ---------------------------------------------------------------------
# Pluggable provider architecture: OpenAI, Anthropic, or Google Gemini
AI_PROVIDER="gemini" # Options: gemini | openai | anthropic
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------
# Academic Literature Search APIs (Optional / Configurable)
# ---------------------------------------------------------------------
NCBI_PUBMED_API_KEY=""
CROSSREF_MAILTO="admin@ib-slr.local" # Required by Crossref etiquette
OPENALEX_MAILTO="admin@ib-slr.local"
SEMANTIC_SCHOLAR_API_KEY=""

# ---------------------------------------------------------------------
# Object Storage (PDFs & Media Assets)
# ---------------------------------------------------------------------
STORAGE_BUCKET_DOCUMENTS="project-documents"
STORAGE_BUCKET_MEDIA="cms-media"
STORAGE_MAX_FILE_SIZE_MB="25"

# ---------------------------------------------------------------------
# Email SMTP Service (Verification & Invitations)
# ---------------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="IB-SLR System <no-reply@ib-slr.local>"
